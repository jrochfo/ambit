{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ambit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Only reachable at ambit.zone (public since 2026-10-09; the Cloudflare Access app stays,
  // with a Bypass policy, so it can be locked again). workers.dev and preview URLs stay off.
  "routes": [{ "pattern": "ambit.zone", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Per-visitor cap on /api/isochrones (worker/index.ts), so one visitor can't use up the daily
  // Isochrones quota. One address is one request (its rings are batched); adding a time is one more.
  "ratelimits": [{ "name": "ISOCHRONE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
  // GOOGLE_ISOCHRONES_SERVER_KEY is a secret: read from .env in dev,
  // set with `npx wrangler secret put GOOGLE_ISOCHRONES_SERVER_KEY` for prod.
}
