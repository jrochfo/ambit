{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ambit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Only reachable at ambit.zone (behind Cloudflare Access until launch);
  // workers.dev and preview URLs would bypass Access, so they're off.
  "routes": [{ "pattern": "ambit.zone", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
  // GOOGLE_ISOCHRONES_SERVER_KEY is a secret: read from .env in dev,
  // set with `npx wrangler secret put GOOGLE_ISOCHRONES_SERVER_KEY` for prod.
}
